# BambuLab Cloud Credentials
# Option 1: Email + password login
BAMBU_EMAIL=your@email.com
BAMBU_PASSWORD=your_password

# Option 2: Direct token (if MFA is enabled, get token from BambuLab app)
# BAMBU_TOKEN=your_access_token
# BAMBU_USER_ID=your_user_id

# Region: us, cn, eu
BAMBU_REGION=us

# Server
PORT=3000
HOST=0.0.0.0

# Where bambuzle.db and admin-token live (default: project root; Docker: /data)
# BAMBUZLE_DATA_DIR=/var/lib/bambuzle

# Dashboard access. Every /api route and the WebSocket require the admin token.
# If unset, a token is generated on first start, written to <data dir>/admin-token, and logged once.
# BAMBUZLE_ADMIN_TOKEN=choose-a-long-random-string
# Let anyone on the network VIEW (GET + live updates) without the token; changes still need it:
# BAMBUZLE_PUBLIC_READ=true
# Behind a reverse proxy (nginx/Caddy/Traefik): trust it so client IPs and HTTPS are detected
# BAMBUZLE_TRUST_PROXY=1
# LAN printer connections verify the printer's TLS cert against Bambu's CAs. Escape hatch only:
# BAMBUZLE_LAN_TLS_VERIFY=off
# Home Assistant bridge (read-only MQTT discovery to YOUR broker, e.g. the Mosquitto add-on):
# BAMBUZLE_HA_MQTT_URL=mqtt://homeassistant.local:1883
# BAMBUZLE_HA_MQTT_USERNAME=bambuzle
# BAMBUZLE_HA_MQTT_PASSWORD=...
# Disable dashboard auth entirely (anyone who can reach the server can stop prints):
# BAMBUZLE_AUTH=off

# Logging: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
